{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "node scripts/deploy/generate-pilot-release.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run test:fast",
    "test:fast": "npm run check:boundaries && npm run typecheck && npm run build && node scripts/quality/run-node-tests.mjs --dot tests/unit tests/workflow tests/component",
    "test:unit": "node scripts/quality/run-node-tests.mjs tests/unit",
    "test:workflow": "node scripts/quality/run-node-tests.mjs tests/workflow",
    "test:component": "node scripts/quality/run-node-tests.mjs tests/component tests/workflow/workflow-command-adapter.test.mjs tests/unit/infrastructure/pilot-first-use-core.test.mjs",
    "test:security": "node --test tests/unit/infrastructure/security-headers.test.mjs tests/unit/infrastructure/pilot-api-redaction.test.mjs tests/unit/infrastructure/pilot-admin-session.test.mjs tests/unit/infrastructure/rate-limit-core.test.mjs tests/unit/infrastructure/pilot-source-consent.test.mjs",
    "test:dependencies": "node scripts/quality/check-production-dependencies.mjs",
    "test:sqlite:health": "node scripts/data/check-sqlite-health.mjs",
    "data:v3:reset": "node scripts/data/reset-v3-runtime-data.mjs",
    "data:v3:reset:apply": "node scripts/data/reset-v3-runtime-data.mjs --apply",
    "test:migrations:compat": "node scripts/data/check-migration-compatibility.mjs",
    "test:performance": "node scripts/quality/check-build-budget.mjs",
    "test:integration": "node --test tests/integration/sqlite-api/*.integration.mjs",
    "test:vertical": "node --test tests/integration/sqlite-api/pilot-vertical-flow.integration.mjs",
    "test:http:live": "node --test tests/integration/http-live/*.integration.mjs",
    "test:logic:retest": "node --test tests/unit/domain/function-retest-transition-core.test.mjs tests/workflow/function-retest-flow.test.mjs tests/unit/domain/function-evidence-core.test.mjs tests/unit/domain/retest-eligibility-core.test.mjs tests/unit/domain/treatment-session-core.test.mjs tests/unit/domain/chief-retest-history-core.test.mjs",
    "test:logic:queue": "node --test tests/unit/domain/treatment-queue-core.test.mjs tests/unit/domain/treatment-queue-eligibility-core.test.mjs tests/unit/domain/treatment-queue-direction-core.test.mjs tests/unit/domain/workflow-state-core.test.mjs tests/unit/domain/retest-routing-core.test.mjs tests/unit/domain/retest-reuse-core.test.mjs tests/unit/domain/trial-record-builder.test.mjs",
    "test:logic:ledger": "node --test tests/unit/domain/treatment-ledger-core.test.mjs tests/unit/domain/problem-ledger-core.test.mjs tests/unit/domain/training-feedback-core.test.mjs tests/unit/domain/training-stage-gate-core.test.mjs tests/unit/domain/bilateral-flow-core.test.mjs tests/unit/domain/treatment-record-flow-core.test.mjs tests/unit/domain/treatment-record-ledger-queue-flow.test.mjs",
    "test:logic:mutations": "node scripts/quality/verify-logic-mutations.mjs",
    "test:browser:target": "node scripts/quality/run-browser-tests.mjs target --project=edge-target",
    "test:browser:p0": "node scripts/quality/run-browser-tests.mjs p0 --project=edge-full --grep @p0",
    "test:browser:full": "node scripts/quality/run-browser-tests.mjs full --project=edge-full",
    "test:browser:release": "node scripts/quality/run-browser-tests.mjs release --project=edge-release --grep @release",
    "test:browser:overall": "node scripts/quality/run-browser-tests.mjs overall tests/browser/overall --project=edge-full",
    "test:browser:mobile-preview": "node scripts/quality/run-browser-tests.mjs mobile-preview tests/browser/mobile-preview --project=pixel-5-preview --project=iphone-13-preview",
    "test:browser:firefox-risk": "node scripts/quality/run-browser-tests.mjs firefox-risk tests/browser/firefox --project=firefox-risk --grep @firefox-risk",
    "test:visual": "node scripts/quality/run-browser-tests.mjs visual --project=edge-full --grep @visual",
    "test:explore": "node scripts/quality/run-browser-tests.mjs explore tests/browser/exploration --project=edge-full",
    "test:summary": "node scripts/quality/quality-summary.mjs",
    "test:release": "node scripts/quality/run-quality-gates.mjs --include-browser",
    "release:package": "node scripts/deploy/package-vps-release.mjs",
    "check:boundaries": "node scripts/quality/check-architecture-boundaries.mjs",
    "check:cycles": "node scripts/quality/check-module-cycles.mjs",
    "check:structure": "node scripts/quality/check-repository-structure.mjs",
    "check:docs": "node scripts/docs/check-markdown-links.mjs",
    "check:assets": "node scripts/docs/check-asset-manifest.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "axe-core": "^4.13.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2"
  },
  "type": "module"
}
