      "forbiddenExits": ["duplicate-stage-event", "cross-type-id-conflict"],
      "stateEffects": ["retry does not advance revision", "new semantic event advances revision once"],
      "evidence": [{ "test": "tests/workflow/stage-event-core.test.mjs", "type": "behavior", "status": "active" }, { "test": "tests/unit/infrastructure/pilot-case-service.test.mjs", "type": "behavior", "status": "partial" }]
