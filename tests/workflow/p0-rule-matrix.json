      "legalExits": ["current-case-event-enqueued", "no-remote-case-no-event"],
      "forbiddenExits": ["older-case-selected-from-record-order", "same-complaint-case-reused"],
      "stateEffects": ["only active case revision may advance", "other cases remain unchanged"],
      "evidence": [{ "test": "tests/unit/infrastructure/local-case-identity.test.mjs", "type": "behavior", "status": "active" }]
    },
    {
      "ruleId": "AUDIT-03",
      "priority": "P0",
